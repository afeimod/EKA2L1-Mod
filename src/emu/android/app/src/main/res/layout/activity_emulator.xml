<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emulator_frame" android:layout_width="match_parent" android:layout_height="match_parent">
    <com.github.eka2l1.phone.PhoneShellLayout android:id="@+id/emulator_container"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <com.github.eka2l1.phone.PhoneToolbar android:id="@+id/toolbar" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="#1C3040"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />
            <SurfaceView android:id="@+id/surface_view" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </com.github.eka2l1.phone.PhoneShellLayout>
    <com.github.eka2l1.emu.overlay.OverlayView android:id="@+id/overlay"
        android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
</FrameLayout>
